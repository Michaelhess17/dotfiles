 /* wallust template - colors-rofi */

* {
active-background: #545256;
active-foreground: #DCDADE;
normal-background: #303030;
normal-foreground: #DCDADE;
urgent-background: #8A858E;
urgent-foreground: #DCDADE;

alternate-active-background: #757079;
alternate-active-foreground: #DCDADE;
alternate-normal-background: #303030;
alternate-normal-foreground: #DCDADE;
alternate-urgent-background: #303030;
alternate-urgent-foreground: #DCDADE;

selected-active-background: #545256;
selected-active-foreground: #DCDADE;
selected-normal-background: #C5C2C8;
selected-normal-foreground: #DCDADE;
selected-urgent-background: #8A858E;
selected-urgent-foreground: #DCDADE;

background-color: #303030;
background: rgba(0,0,0,0.7);
foreground: #C5C2C8;
border-color: #545256;
}

